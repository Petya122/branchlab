# Edge reverse proxy for every site on the branchlab.tech server.
# Caddy obtains and renews the Let's Encrypt certificates automatically
# and redirects HTTP -> HTTPS. Upstreams are reached by container name
# over the shared "proxy" Docker network.
#
# Changes here are deployed by CI: the deploy job pulls the repo and runs
# `caddy reload`. Never edit this file directly on the server.

# Shared response headers
(security_headers) {
	header {
		# Browsers must use HTTPS for this domain and its subdomains for a year
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Don't advertise server software
		-Server
		-Via
	}
}

# Imported by every site. Error responses (e.g. a 502 when an upstream is down)
# skip the normal `header` handler, so they get the same headers through
# handle_errors.
(security) {
	import security_headers
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

branchlab.tech, www.branchlab.tech {
	import security
	encode zstd gzip
	reverse_proxy branchlab:8080
}

# Login wall (infra/tinyauth): every request must carry a valid tinyauth
# session cookie (password + TOTP), otherwise browsers are redirected to
# https://auth.branchlab.tech. If tinyauth is down, requests fail (no bypass).
(tinyauth) {
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
	}
}

auth.branchlab.tech {
	import security
	reverse_proxy tinyauth:3000
}

# Arcane (Docker management UI) has full control over the Docker socket,
# so it sits behind the tinyauth login in addition to its own login.
arcane.branchlab.tech {
	import security
	import tinyauth
	reverse_proxy arcane:3552
}

codeblue.branchlab.tech {
	import security
	reverse_proxy codeblue-backend:3001
}
