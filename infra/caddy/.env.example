# Copy to infra/caddy/.env on the server (never commit the real file).
# Generate the hash ON THE SERVER, it will prompt for the password:
#   docker run --rm -it caddy:2-alpine caddy hash-password
# Keep the single quotes: the bcrypt hash contains "$" characters.
ARCANE_AUTH_USER='admin'
ARCANE_AUTH_HASH='$2a$14$replace-with-the-generated-hash'
